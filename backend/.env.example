# --- Servidor ---
PORT=4000
# Origen(es) del frontend autorizados (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# --- Base de datos PostgreSQL ---
# En Render/Tiger Cloud empieza por postgres://  y suele requerir SSL.
DATABASE_URL=postgres://usuario:clave@host:5432/base
# Pon "false" solo si tu Postgres local no usa SSL.
PGSSL=true

# --- Autenticación ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRA=30d

# --- Cloudinary (imágenes de las prendas) ---
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
CLOUDINARY_FOLDER=hilo-circular
