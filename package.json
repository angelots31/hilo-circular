{
  "name": "hilo-circular",
  "private": true,
  "version": "0.1.0",
  "description": "Marketplace de intercambio de ropa en Medellín: frontend React + Vite y backend Express + PostgreSQL.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm --prefix hilo/backend install --no-audit --no-fund && npm --prefix hilo/frontend install --no-audit --no-fund",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix hilo/backend run dev",
    "dev:web": "npm --prefix hilo/frontend run dev",
    "demo": "concurrently -n api,web -c blue,magenta \"npm:demo:api\" \"npm:dev:web\"",
    "demo:api": "npm --prefix hilo/backend run demo",
    "start": "npm --prefix hilo/backend start",
    "build": "npm --prefix hilo/frontend run build",
    "preview": "npm --prefix hilo/frontend run preview",
    "test": "npm --prefix hilo/backend test",
    "db:setup": "npm --prefix hilo/backend run db:setup"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
